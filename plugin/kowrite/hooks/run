#!/usr/bin/env bash
# 이 PC에서 쓸 수 있는 Python 3.8 이상을 찾아 훅을 실행한다.
# Windows 스토어 별칭이 성공 코드만 반환해도 실제 Python 출력이 없으면 건너뛴다.
for python in python3 python py; do
  if [[ "$("$python" -c 'import sys; print("kowrite-python-ok" if sys.version_info >= (3, 8) else "", end="")' 2>/dev/null)" == "kowrite-python-ok" ]]; then
    exec "$python" "$(dirname "$0")/kowrite.py" "$@"
  fi
done
exit 0
